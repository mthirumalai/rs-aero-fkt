generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RigSize {
  AERO_5
  AERO_6
  AERO_7
  AERO_9
}

enum CourseStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum AttemptStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum CourseType {
  ONE_WAY
  OUT_AND_BACK
}

enum PointType {
  POINT
  LINE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  bio              String?
  location         String?
  preferredRigSize RigSize?
  createdAt        DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  courses  Course[]
  attempts FktAttempt[]
  courseStatusChanges CourseStatusHistory[]
}

model Course {
  id            String       @id @default(cuid())
  name          String
  description   String?
  country       String
  courseType    CourseType   @default(ONE_WAY)

  // Start configuration
  startName     String
  startType     PointType    @default(POINT)
  startLat      Float        // For POINT: the point. For LINE: endpoint 1
  startLng      Float        // For POINT: the point. For LINE: endpoint 1
  startLine2Lat Float?       // For LINE: endpoint 2
  startLine2Lng Float?       // For LINE: endpoint 2

  // Finish configuration
  finishName    String
  finishType    PointType    @default(POINT)
  finishLat     Float        // For POINT: the point. For LINE: endpoint 1
  finishLng     Float        // For POINT: the point. For LINE: endpoint 1
  finishLine2Lat Float?      // For LINE: endpoint 2
  finishLine2Lng Float?      // For LINE: endpoint 2

  // Turning mark (always POINT for out-and-back)
  turningMarkName String?
  turningMarkLat  Float?
  turningMarkLng  Float?

  distanceKm    Float?
  status        CourseStatus @default(PENDING)
  submittedById String
  submittedAt   DateTime     @default(now())
  approvedAt       DateTime?
  approvalToken    String?     @unique
  rejectionReason  String?

  submittedBy User          @relation(fields: [submittedById], references: [id])
  photos      CoursePhoto[]
  attempts    FktAttempt[]
  statusHistory CourseStatusHistory[]
}

model CoursePhoto {
  id        String   @id @default(cuid())
  courseId  String
  s3Key     String
  caption   String?
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model FktAttempt {
  id             String        @id @default(cuid())
  courseId       String
  athleteId      String
  rigSize        RigSize
  date           DateTime
  durationSec    Int
  gpxS3Key       String
  gpxValidated   Boolean       @default(false)
  avgSogKnots    Float?
  maxSogKnots    Float?
  windSpeedKnots Float?
  windDirection  String?
  currentNotes   String?
  writeUp          String?
  trackSourceUrl   String?
  sailorName       String?
  sailorEmail      String?
  status           AttemptStatus @default(PENDING)
  submittedAt    DateTime      @default(now())
  raceStartIndex   Int?
  raceEndIndex     Int?

  course  Course         @relation(fields: [courseId], references: [id])
  athlete User           @relation(fields: [athleteId], references: [id])
  photos  AttemptPhoto[]
}

model AttemptPhoto {
  id        String   @id @default(cuid())
  attemptId String
  s3Key     String
  caption   String?
  createdAt DateTime @default(now())

  attempt FktAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model CourseStatusHistory {
  id            String       @id @default(cuid())
  courseId      String
  fromStatus    CourseStatus?
  toStatus      CourseStatus
  reason        String?      // Rejection reason or approval notes
  changedById   String?
  changedAt     DateTime     @default(now())
  approvalToken String?      // Token used for this status change

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  changedBy User?  @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([changedAt])
}
